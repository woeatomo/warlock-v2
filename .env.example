# Salin ke .env lalu isi. JANGAN pernah membagikan .env atau folder secrets/.
# --- Telegram ---
# Token bot TIDAK ditaruh di sini: tulis TELEGRAM_BOT_TOKEN=... di secrets/telegram.env (dibuat install.sh, izin 600).
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_ID=
ALLOWED_TG_IDS=
TELEGRAM_BOT_USERNAME=

# --- RPC & API ---
HELIUS_API_KEY=
SOLANA_RPC_URL=
JUPITER_API_KEY=

# --- Wallet (hanya untuk LIVE) ---
# Disarankan: simpan kunci terenkripsi dengan `node set-wallet-key.js` dan biarkan PRIVATE_KEY kosong.
PRIVATE_KEY=

# --- Mode (bawaan dry run) ---
PAPER=1
DRY_RUN=1
LIVE_CONFIRMED=0

# --- Mini App ---
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8797
MINIAPP_URL=

# Strategi, filter, dan exit diatur dari Mini App (Settings) dan tersimpan di paper/settings.json.
